# Copy to `.cargo/local.toml`, which git ignores, to build mira against a
# checkout of Armature beside it rather than the revision the manifests name:
# changes made there are then seen here at once, by Neo's widgets as well.

[patch."https://github.com/mcdearman/armature"]
armature = { path = "../armature/crates/armature" }
armature-render = { path = "../armature/crates/armature-render" }

@pub fun meshCube (sys : System) (size : Float) : Int ! { Process | e } = call sys 23 [Arg.Int 0, Arg.Float32 size]
@pub fun meshSphere (sys : System) (radius : Float) : Int ! { Process | e } = call sys 23 [Arg.Int 1, Arg.Float32 radius]

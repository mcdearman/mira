-- States a fact: a signal true or false, as the plugin found it.
@pub fun setSignal (sys : System) (name : String) (value : Bool) : () ! { Process | e } =
  Ffi.withText name (\t n -> callUnit sys 48 [Arg.Ptr t, Arg.Int n, Arg.Float (if value then 1.0 else 0.0), Arg.Int 0])

-- States a fact that is a number.
@pub fun setSignalNumber (sys : System) (name : String) (value : Float) : () ! { Process | e } =
  Ffi.withText name (\t n -> callUnit sys 48 [Arg.Ptr t, Arg.Int n, Arg.Float value, Arg.Int 1])

-- A signal's value as of its last update (a truth as 1 or 0), or 0 if there is none.
@pub fun signal (sys : System) (name : String) : Float ! { Process | e } =
  Ffi.withText name (\t n -> Ffi.withBuffer 8 (\out ->
    let found = call sys 49 [Arg.Ptr t, Arg.Int n, Arg.Ptr out] in
    if found == 0 then 0.0 else okFloat (Ffi.readFloat out F64)))

-- Whether a signal is true (and there is one).
@pub fun signalIsTrue (sys : System) (name : String) : Bool ! { Process | e } = not (signal sys name == 0.0)

-- How a rule works its signal out from its inputs, for `defineSignal`.
@pub def signalAnd : Int = 0
@pub def signalOr : Int = 1
@pub def signalNot : Int = 2
-- How many inputs are true.
@pub def signalCount : Int = 3
@pub def signalSum : Int = 4
-- Input 1 if input 0 is true, else input 2.
@pub def signalSelect : Int = 5
-- The seconds input 0 has been true; input 1 sets it back to nought.
@pub def signalTimer : Int = 6
-- Input 0 against input 1.
@pub def signalLess : Int = 8
@pub def signalLessOrEqual : Int = 9
@pub def signalEqual : Int = 10
@pub def signalGreaterOrEqual : Int = 11
@pub def signalGreater : Int = 12

-- Defines a signal worked out from others, its inputs, by name (a rule), or defines it anew,
-- when the system returns.
@pub fun defineSignal (sys : System) (name : String) (op : Int) (inputs : [String]) : () ! { Process | e } =
  defining sys name op 0.0 inputs

-- A rule true once its input has been true for so many seconds.
@pub fun defineHeldFor (sys : System) (name : String) (seconds : Float) (input : String) : () ! { Process | e } =
  defining sys name 7 seconds [input]

-- A setting: a number, or a truth, that stands until someone changes it, in the graph or in
-- the rules' text.
@pub fun defineNumber (sys : System) (name : String) (value : Float) : () ! { Process | e } = defining sys name 13 value []

@pub fun defineTruth (sys : System) (name : String) (value : Bool) : () ! { Process | e } =
  defining sys name 14 (if value then 1.0 else 0.0) []

fun defining sys name op param inputs =
  Ffi.withText name (\t n -> Ffi.withText (S.join " " inputs) (\i m ->
    callUnit sys 50 [Arg.Ptr t, Arg.Int n, Arg.Int op, Arg.Float param, Arg.Ptr i, Arg.Int m]))


@pub fun setMesh (sys : System) (entity : Int) (mesh : Int) : () ! { Process | e } = callUnit sys 25 [Arg.Int entity, Arg.Int mesh]

-- A plain matte surface of a colour.
@pub fun setColor (sys : System) (entity : Int) (color : (Float, Float, Float)) : () ! { Process | e } =
  match color with
  | (r, g, b) ->
      Ffi.withBuffer 36 (\m ->
        let u1 = Ffi.writeFloats m 4 [r, g, b, 1.0, 0.0, 0.0, 0.0, 0.8, 0.0] in
        callUnit sys 26 [Arg.Int entity, Arg.Ptr m])

-- Makes an entity a camera (it also needs a transform), the one drawn from.
@pub fun setCamera (sys : System) (entity : Int) : () ! { Process | e } =
  Ffi.withBuffer 12 (\c ->
    let u1 = Ffi.writeFloats c 4 [1.0471976, 0.1] in
    let u2 = Ffi.writeInt (Ffi.offset c 8) U32 1 in
    callUnit sys 30 [Arg.Int entity, Arg.Ptr c])

-- Makes an entity a sun (it also needs a transform), shining along its forward direction.
@pub fun setLight (sys : System) (entity : Int) (intensity : Float) : () ! { Process | e } =
  Ffi.withBuffer 20 (\l ->
    let u1 = Ffi.writeFloats l 4 [1.0, 1.0, 1.0, intensity] in
    let u2 = Ffi.writeInt (Ffi.offset l 16) U32 1 in
    callUnit sys 31 [Arg.Int entity, Arg.Ptr l])

-- Makes an entity an orthographic camera, the one drawn from: the view is `height` metres of
-- the world tall, and things do not shrink with distance; nothing nearer than `near` or
-- farther than `far` is drawn.
@pub fun setCameraOrthographic (sys : System) (entity : Int) (height : Float) (near : Float) (far : Float) : () ! { Process | e } =
  callUnit sys 51 [Arg.Int entity, Arg.Float32 height, Arg.Float32 near, Arg.Float32 far, Arg.Int 1]

-- The light that reaches everything, from no direction: its colour and how strong it is.
@pub fun setAmbient (sys : System) (color : (Float, Float, Float)) (intensity : Float) : () ! { Process | e } =
  let (r, g, b) = color in
  Ffi.withBuffer 12 (\c ->
    let u = Ffi.writeFloats c 4 [r, g, b] in
    callUnit sys 32 [Arg.Ptr c, Arg.Float32 intensity])

-- Makes `child` move with `parent`: its transform is then relative to the parent's. With
-- `noEntity` as the parent, it stands by itself again.
@pub fun setParent (sys : System) (child : Int) (parent : Int) : () ! { Process | e } = callUnit sys 44 [Arg.Int child, Arg.Int parent]

-- No entity, where one is asked for.
@pub def noEntity : Int = 0 - 1

-- Despawns an entity and everything below it (a model and its parts, say).
@pub fun despawnTree (sys : System) (entity : Int) : () ! { Process | e } = callUnit sys 45 [Arg.Int entity]

-- How a surface looks: its colour (red, green, blue and how opaque, linear), the light it
-- gives off itself, how rough it is (0 mirror-smooth to 1 matte) and how metallic (0 or 1).
@pub fun setMaterial (sys : System) (entity : Int) (color : (Float, Float, Float, Float)) (glow : (Float, Float, Float)) (roughness : Float) (metallic : Float) : () ! { Process | e } =
  let (r, g, b, a) = color in
  let (er, eg, eb) = glow in
  Ffi.withBuffer 36 (\m ->
    let u = Ffi.writeFloats m 4 [r, g, b, a, er, eg, eb, roughness, metallic] in
    callUnit sys 26 [Arg.Int entity, Arg.Ptr m])

-- Makes an entity a perspective camera: its vertical field of view in radians, the nearest
-- distance drawn, and whether it is active (the first active camera is the one drawn).
@pub fun setCameraWith (sys : System) (entity : Int) (fov : Float) (near : Float) (active : Bool) : () ! { Process | e } =
  Ffi.withBuffer 12 (\c ->
    let u1 = Ffi.writeFloats c 4 [fov, near] in
    let u2 = Ffi.writeInt (Ffi.offset c 8) U32 (if active then 1 else 0) in
    callUnit sys 30 [Arg.Int entity, Arg.Ptr c])

-- Makes an entity a sun of a colour, so strong, casting shadows or not.
@pub fun setLightWith (sys : System) (entity : Int) (color : (Float, Float, Float)) (intensity : Float) (shadows : Bool) : () ! { Process | e } =
  let (r, g, b) = color in
  Ffi.withBuffer 20 (\l ->
    let u1 = Ffi.writeFloats l 4 [r, g, b, intensity] in
    let u2 = Ffi.writeInt (Ffi.offset l 16) U32 (if shadows then 1 else 0) in
    callUnit sys 31 [Arg.Int entity, Arg.Ptr l])

-- A mesh of these vertices (each a position, a normal and a texture coordinate) and the
-- triangles through them, three indices each, counter-clockwise seen from the front. 0 if
-- it cannot be made.
@pub fun meshCreate (sys : System) (vertices : [((Float, Float, Float), (Float, Float, Float), (Float, Float))]) (indices : [Int]) : Int ! { Process | e } =
  let floats = concatMap (\v -> let (p, n, uv) = v in let (px, py, pz) = p in let (nx, ny, nz) = n in let (u, w) = uv in [px, py, pz, nx, ny, nz, u, w]) vertices in
  Ffi.withBuffer (4 * max 1 (len floats)) (\vs -> Ffi.withBuffer (4 * max 1 (len indices)) (\is ->
    let u1 = Ffi.writeFloats vs 4 floats in
    let u2 = Ffi.writeInts is 4 indices in
    call sys 24 [Arg.Ptr vs, Arg.Int (len vertices), Arg.Ptr is, Arg.Int (len indices)] % 4294967296))

-- An image by name: a PNG or JPEG in the game's assets, with "?linear" after it for data
-- such as a normal map. It draws as plain white until it has arrived.
@pub fun imageLoad (sys : System) (name : String) : Int ! { Process | e } =
  Ffi.withText name (\t n -> call sys 41 [Arg.Ptr t, Arg.Int n] % 4294967296)

-- An entity's textures: its colour, its normals, and how metallic and rough; 0 leaves one
-- unset.
@pub fun setTextures (sys : System) (entity : Int) (color : Int) (normal : Int) (metallicRoughness : Int) : () ! { Process | e } =
  callUnit sys 42 [Arg.Int entity, Arg.Int color, Arg.Int normal, Arg.Int metallicRoughness]

-- A glTF model by name, at a place: one new entity, with one below it for each part, which
-- appear when the system returns.
@pub fun spawnModel (sys : System) (name : String) (at : (Float, Float, Float)) (rotation : (Float, Float, Float, Float)) (scale : (Float, Float, Float)) : Int ! { Process | e } =
  Ffi.withText name (\t n -> withTransform at rotation scale (\x -> call sys 43 [Arg.Ptr t, Arg.Int n, Arg.Ptr x]))

-- A prefab by name (a scene file in the game's assets, or a scene's name), at a place: one
-- new entity, with the prefab's entities below it from the next frame.
@pub fun spawnPrefab (sys : System) (name : String) (at : (Float, Float, Float)) (rotation : (Float, Float, Float, Float)) (scale : (Float, Float, Float)) : Int ! { Process | e } =
  Ffi.withText name (\t n -> withTransform at rotation scale (\x -> call sys 46 [Arg.Ptr t, Arg.Int n, Arg.Ptr x]))


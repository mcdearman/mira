@pub def air : Int = 0

-- What a ray through the blocks met: the block, the face of it (pointing out, or 0 0 0 if
-- the ray began inside), how far along the ray, and the block's kind.
@pub data VoxelHit = VoxelHit (Int, Int, Int) (Int, Int, Int) Float Int

-- A kind of block by name ("stone"), if there is one.
@pub fun voxelBlock (sys : System) (name : String) : Maybe Int ! { Process | e } =
  Ffi.withText name (\t n -> known (call sys 62 [Arg.Ptr t, Arg.Int n]))

-- The kind of block at a place, if the world is made there.
@pub fun voxel (sys : System) (at : (Int, Int, Int)) : Maybe Int ! { Process | e } =
  let (x, y, z) = at in
  known (call sys 63 [Arg.Int x, Arg.Int y, Arg.Int z])

-- Puts a kind of block at a place (air takes one away), when the system returns.
@pub fun setVoxel (sys : System) (at : (Int, Int, Int)) (block : Int) : () ! { Process | e } =
  let (x, y, z) = at in
  callUnit sys 64 [Arg.Int x, Arg.Int y, Arg.Int z, Arg.Int block]

-- Whether the block at a place is solid, or the world is not made there yet.
@pub fun voxelSolid (sys : System) (at : (Int, Int, Int)) : Bool ! { Process | e } =
  let (x, y, z) = at in
  call sys 65 [Arg.Int x, Arg.Int y, Arg.Int z] % 4294967296 != 0

-- The first solid block along a ray from origin the way of direction, within each.
@pub fun voxelRaycast (sys : System) (origin : (Float, Float, Float)) (direction : (Float, Float, Float)) (reach : Float) : Maybe VoxelHit ! { Process | e } =
  let (ox, oy, oz) = origin in
  let (dx, dy, dz) = direction in
  Ffi.withBuffer 12 (\o -> Ffi.withBuffer 12 (\d -> Ffi.withBuffer 32 (\hit ->
    let u1 = Ffi.writeFloats o 4 [ox, oy, oz] in
    let u2 = Ffi.writeFloats d 4 [dx, dy, dz] in
    if call sys 66 [Arg.Ptr o, Arg.Ptr d, Arg.Float32 reach, Arg.Ptr hit] % 256 == 0 then None
    else
      let cell = \i -> ok (Ffi.readInt (Ffi.offset hit (4 * i)) I32) in
      Just (VoxelHit (cell 0, cell 1, cell 2) (cell 3, cell 4, cell 5) (readFloat32 hit 6) (ok (Ffi.readInt (Ffi.offset hit 28) U32))))))

-- Makes an entity the one the world is made around (it also needs a transform): usually the
-- camera.
@pub fun setChunkViewer (sys : System) (entity : Int) : () ! { Process | e } = callUnit sys 67 [Arg.Int entity]

-- A block's kind, or none for MIRA_BLOCK_UNKNOWN.
fun known (block : Int) : Maybe Int =
  let kind = block % 4294967296 in
  if kind == 4294967295 then None else Just kind

-- ---------------------------------------------------------------------------------------
-- One entity of a query, by itself

-- The pointers to an entity's components, as query `q` of the system would give them, if
-- it matches the query.
@pub fun getIn (sys : System) (q : Int) (entity : Int) (count : Int) : Maybe [Ptr] ! { Process | e } =
  Ffi.withBuffer (8 * max 1 count) (\found ->
    if call sys 15 [Arg.Int q, Arg.Int entity, Arg.Ptr found] % 256 == 0 then None
    else Just (map (\i -> pointerAt found i) (range 0 count)))

-- The same, for a query that reads or writes one component: its pointer.
@pub fun getIn1 (sys : System) (q : Int) (entity : Int) : Maybe Ptr ! { Process | e } =
  Ffi.withBuffer 8 (\found ->
    if call sys 15 [Arg.Int q, Arg.Int entity, Arg.Ptr found] % 256 == 0 then None
    else Just (pointerAt found 0))

-- ---------------------------------------------------------------------------------------
-- The order of systems (while loading)

-- Has the system of that name run before, or after, another within its stage: another of
-- this plugin's systems by its name, or anyone's by its full name ("plugin::system", or a
-- set such as "signals"). Answers 0, or why not as another number.
@pub fun runBefore (p : Plugin) (name : String) (other : String) : Int ! { Process | e } = ordering p name 0 other
@pub fun runAfter (p : Plugin) (name : String) (other : String) : Int ! { Process | e } = ordering p name 1 other

fun ordering p name relation other =
  match p with
  | Plugin api app _ ->
      Ffi.withText name (\t n -> Ffi.withText other (\o m ->
        ok (Ffi.callInt (slot api 52) [Arg.Int app, Arg.Ptr t, Arg.Int n, Arg.Int relation, Arg.Ptr o, Arg.Int m]) % 4294967296))

-- ---------------------------------------------------------------------------------------
-- Events: values of a fixed size sent by one system and read by others, this frame and the
-- next. Each system reads each event once.

-- An event type by name, `size` bytes, found by any plugin that knows the name (the engine's
-- own too, as "mira.Contact"). Its handle, or 0.
@pub fun registerEvent (p : Plugin) (name : String) (size : Int) : Int ! { Process | e } =
  match p with
  | Plugin api app _ -> Ffi.withText name (\t n -> ok (Ffi.callInt (slot api 27) [Arg.Int app, Arg.Ptr t, Arg.Int n, Arg.Int size]) % 4294967296)

-- Sends an event: the bytes at `value`.
@pub fun sendEvent (sys : System) (event : Int) (value : Ptr) : () ! { Process | e } = callUnit sys 28 [Arg.Int event, Arg.Ptr value]

-- Sends an event that is 32-bit floats, one after another.
@pub fun sendFloats (sys : System) (event : Int) (xs : [Float]) : () ! { Process | e } =
  Ffi.withBuffer (4 * max 1 (len xs)) (\v ->
    let u = Ffi.writeFloats v 4 xs in
    sendEvent sys event v)

-- Sends an event that is 32-bit integers, one after another.
@pub fun sendInts (sys : System) (event : Int) (ns : [Int]) : () ! { Process | e } =
  Ffi.withBuffer (4 * max 1 (len ns)) (\v ->
    let u = Ffi.writeInts v 4 ns in
    sendEvent sys event v)

-- Works something out from each event of a type this system has not read yet, as `foldIn`
-- does from entities: `body` is given what it has so far and a pointer to the event, `size`
-- bytes.
@pub fun foldEvents (sys : System) (event : Int) (size : Int) (start : a) (body : a -> Ptr -> a ! { Process | e }) : a ! { Process | e } =
  Ffi.withBuffer (max 1 size) (\v -> eventsFrom sys event v start body)

fun eventsFrom sys event v so body =
  if call sys 29 [Arg.Int event, Arg.Ptr v] % 256 == 0 then so
  else eventsFrom sys event v (body so v) body

@pub fun forEachEvent (sys : System) (event : Int) (size : Int) (body : Ptr -> () ! { Process | e }) : () ! { Process | e } =
  foldEvents sys event size () (\u v -> body v)

-- Two colliders touched in a physics step: the engine's "mira.Contact", of `contactSize`
-- bytes. The two entities, where, the way from the first toward the second, and how hard
-- (in newton-seconds).
@pub data Contact = Contact Int Int (Float, Float, Float) (Float, Float, Float) Float

@pub def contactSize : Int = 48

@pub fun contactEvent (p : Plugin) : Int ! { Process | e } = registerEvent p "mira.Contact" contactSize

@pub fun readContact (v : Ptr) : Contact ! { Process | e } =
  Contact (ok (Ffi.readInt v U64)) (ok (Ffi.readInt (Ffi.offset v 8) U64))
    (readFloat32 v 4, readFloat32 v 5, readFloat32 v 6) (readFloat32 v 7, readFloat32 v 8, readFloat32 v 9) (readFloat32 v 10)

-- ---------------------------------------------------------------------------------------
-- Physics, after ``require p "physics"`` where a game is without it.

-- The solid form of a collider, and what its size is.
-- A sphere: the radius first.
@pub def colliderSphere : Int = 0
-- A box: half of its extent along x, y and z.
@pub def colliderBox : Int = 1
-- An upright capsule: the radius, then the height.
@pub def colliderCapsule : Int = 2
-- Everything below the entity's position.
@pub def colliderGround : Int = 3

-- Makes an entity solid: its shape and size, its friction, how much of a bounce it keeps (0
-- to 1), and whether it only notices what overlaps it (a sensor) and blocks nothing.
@pub fun setCollider (sys : System) (entity : Int) (shape : Int) (size : (Float, Float, Float)) (friction : Float) (restitution : Float) (sensor : Bool) : () ! { Process | e } =
  let (a, b, c) = size in
  Ffi.withBuffer 28 (\d ->
    let u1 = Ffi.writeInt d U32 shape in
    let u2 = Ffi.writeFloats (Ffi.offset d 4) 4 [a, b, c, friction, restitution] in
    let u3 = Ffi.writeInt (Ffi.offset d 24) U32 (if sensor then 1 else 0) in
    callUnit sys 34 [Arg.Int entity, Arg.Ptr d])

-- How a body moves: by gravity, forces and collisions; only by its velocity, pushing and
-- never pushed; or as its transform is set, pushing and never pushed.
@pub def bodyDynamic : Int = 0
@pub def bodyKinematic : Int = 1
@pub def bodyAnimated : Int = 2

-- Makes an entity with a collider move: how, its mass in kilograms (0 to work it out from
-- the collider), how it is moving to begin with, and whether it is kept upright.
@pub fun setBody (sys : System) (entity : Int) (kind : Int) (mass : Float) (velocity : (Float, Float, Float)) (upright : Bool) : () ! { Process | e } =
  let (x, y, z) = velocity in
  Ffi.withBuffer 24 (\d ->
    let u1 = Ffi.writeInt d U32 kind in
    let u2 = Ffi.writeFloats (Ffi.offset d 4) 4 [mass, x, y, z] in
    let u3 = Ffi.writeInt (Ffi.offset d 20) U32 (if upright then 1 else 0) in
    callUnit sys 35 [Arg.Int entity, Arg.Ptr d])

-- A sudden push on a dynamic body, in newton-seconds.
@pub fun applyImpulse (sys : System) (entity : Int) (impulse : (Float, Float, Float)) : () ! { Process | e } =
  withVector impulse (\v -> callUnit sys 36 [Arg.Int entity, Arg.Ptr v])

@pub fun setVelocity (sys : System) (entity : Int) (velocity : (Float, Float, Float)) : () ! { Process | e } =
  withVector velocity (\v -> callUnit sys 37 [Arg.Int entity, Arg.Ptr v])

-- A body's velocity, if the entity has a body.
@pub fun velocity (sys : System) (entity : Int) : Maybe (Float, Float, Float) ! { Process | e } =
  withVector (0.0, 0.0, 0.0) (\v ->
    if call sys 38 [Arg.Int entity, Arg.Ptr v] % 256 == 0 then None
    else Just (readFloat32 v 0, readFloat32 v 1, readFloat32 v 2))

-- What a ray through the colliders met: the entity, the point, the way the surface faces
-- there, and how far along the ray.
@pub data RayHit = RayHit Int (Float, Float, Float) (Float, Float, Float) Float

-- The first collider a ray from `origin` the way of `direction` meets within `reach`, as
-- things stood after the last physics step.
@pub fun raycast (sys : System) (origin : (Float, Float, Float)) (direction : (Float, Float, Float)) (reach : Float) : Maybe RayHit ! { Process | e } =
  withVector origin (\o -> withVector direction (\d -> Ffi.withBuffer 40 (\hit ->
    if call sys 39 [Arg.Ptr o, Arg.Ptr d, Arg.Float32 reach, Arg.Ptr hit] % 256 == 0 then None
    else Just (RayHit (ok (Ffi.readInt hit U64)) (readFloat32 hit 2, readFloat32 hit 3, readFloat32 hit 4) (readFloat32 hit 5, readFloat32 hit 6, readFloat32 hit 7) (readFloat32 hit 8)))))

-- Three floats in memory, for `body` to hand the engine.
fun withVector (v : (Float, Float, Float)) body =
  let (x, y, z) = v in
  Ffi.withBuffer 12 (\p ->
    let u = Ffi.writeFloats p 4 [x, y, z] in
    body p)
-- RetroDunk: pixel-art basketball, three on three on half a court, seen from above. You
-- play every one of your team's possessions; the other team's are played out for you and
-- told, as Retro Bowl does with its defence. First to 21 wins, and your record is kept.
--
-- > cargo run --bin mira-play -- examples/retro_dunk
--
-- WASD or the arrows move whoever has the ball. Hold Space (or the left mouse button) to
-- rise for a shot and let go at the top of the meter: green is the sweet spot. E (or the
-- right mouse button) passes to the most open teammate, and you play on as them. Inside
-- the arc a basket is 2, beyond it 3; close in, it is a dunk. The shot clock is 14
-- seconds, and a defender left at your side long enough takes the ball.
--
-- Everything seen and heard is made here, from code: the court, the players, the ball and
-- the letters are pictures worked out pixel by pixel, and the sounds sample by sample.

use Mira as M
use Std.Num.Float as F
use Std.Collections.Vector as V
use Std.String as S
use Std.Char as C
use Std.Ffi (Ptr)

-- ---------------------------------------------------------------------------------------
-- The court, in metres: x across, z from the baseline (top of the screen) to half court.

def baseline : Float = 0.0 -. 7.0
def halfCourt : Float = 7.0
def sideline : Float = 7.5
def hoopZ : Float = 0.0 -. 5.4
def arc : Float = 6.75
def toWin : Int = 21
def shotClockSeconds : Float = 14.0
def runSpeed : Float = 5.2
def guardSpeed : Float = 4.2
def game : String = "RetroDunk"

-- What the systems are kept, by place.
def transformAt : Int = 0
def playerAt : Int = 1
def ballAt : Int = 2
def textAt : Int = 3
def intsAt : Int = 4
def floatsAt : Int = 5
def glyphsAt : Int = 6

-- The game's numbers, in a block the engine keeps: whole numbers by place...
def phaseI : Int = 0
def oursI : Int = 1
def theirsI : Int = 2
def handlerI : Int = 3
def seedI : Int = 4
def winsI : Int = 5
def lossesI : Int = 6
def pointsI : Int = 7
def madeI : Int = 8
def passToI : Int = 9
def messageI : Int = 10
def shownI : Int = 11
def afterI : Int = 12
def bounceI : Int = 13
def gamesI : Int = 14
def startedI : Int = 15
-- ...the pictures and sounds made at the start...
def ourFrameI : Int = 20
def theirFrameI : Int = 22
def ballImageI : Int = 24
def shadowImageI : Int = 25
def markerImageI : Int = 26
def tileI : Int = 27
def dribbleI : Int = 30
def swishI : Int = 31
def clankI : Int = 32
def buzzerI : Int = 33
def cheerI : Int = 34
-- ...and the fractional ones.
def timerF : Int = 0
def clockF : Int = 1
def meterF : Int = 2
def risingF : Int = 3
def ballXF : Int = 4
def ballZF : Int = 5
def ballHF : Int = 6
def fromXF : Int = 7
def fromZF : Int = 8
def flightF : Int = 9
def lengthF : Int = 10
def toXF : Int = 11
def toZF : Int = 12
def guardedF : Int = 13
def nowF : Int = 14

-- The phases of a possession.
def ready : Int = 0
def live : Int = 1
def shooting : Int = 2
def result : Int = 3
def theirTurn : Int = 4
def over : Int = 5
def passing : Int = 6

-- What is said in the middle of the court, by number.
fun said (message : Int) : String =
  if message == 1 then "SWISH!"
  else if message == 2 then "THREE!"
  else if message == 3 then "DUNK!"
  else if message == 4 then "MISS"
  else if message == 5 then "STOLEN!"
  else if message == 6 then "SHOT CLOCK"
  else if message == 7 then "THEY SCORE 2"
  else if message == 8 then "THEY HIT A 3"
  else if message == 9 then "STOP!"
  else if message == 10 then "YOU WIN!"
  else if message == 11 then "YOU LOSE"
  else if message == 12 then "YOUR BALL"
  else if message == 13 then "REBOUND!"
  else if message == 14 then "PICKED OFF"
  else ""

-- ---------------------------------------------------------------------------------------
-- Loading

@export
fun mira_plugin_load (api : Int) (app : Int) : Int32 ! Process =
  M.load api app (\p ->
    let transform = M.lookupComponent p "mira.Transform" in
    -- A player: team (0 yours, 1 theirs), place in the team, and how far it has run.
    let player = M.registerComponent p "dunk.Player" 16 4 in
    -- The ball (0), its shadow (1), and the mark over whoever has it (2).
    let ball = M.registerComponent p "dunk.Ball" 4 4 in
    -- A letter: on the board (1), said in the middle (2), or the help (3).
    let text = M.registerComponent p "dunk.Text" 4 4 in
    let ints = M.state p "dunk.ints" 256 4 in
    let floats = M.state p "dunk.floats" 128 4 in
    let glyphs = M.state p "dunk.glyphs" 256 4 in
    let u = M.keep p [transform, player, ball, text, M.address ints, M.address floats, M.address glyphs] in
    -- A flat picture, every surface its own colour, nothing smoothed.
    let looks = [
        M.setting p "view_mode" M.viewUnlit,
        M.setting p "ray_tracing" 0.0,
        M.setting p "taa" 0.0,
        M.setting p "bloom" 0.0,
        M.setting p "vignette" 0.0,
        M.setting p "grain" 0.0,
        M.setting p "sharpen" 0.0
      ]
    in
    let keys = [
        M.bindAxis p "across" "KeyA" "KeyD",
        M.bindAxis p "across" "ArrowLeft" "ArrowRight",
        M.bindAxis p "along" "KeyW" "KeyS",
        M.bindAxis p "along" "ArrowUp" "ArrowDown",
        M.bindAction p "shoot" "Space",
        M.bindAction p "shoot" "MouseLeft",
        M.bindAction p "pass" "KeyE",
        M.bindAction p "pass" "MouseRight"
      ]
    in
    let added = [
        M.addSystem p "setup" M.startup "dunk_setup" [],
        M.addSystemWith p "play" M.update "dunk_play" [
            [M.writes player, M.writes transform, M.lacking ball],
            [M.reads ball, M.writes transform],
            [M.reads text]
          ]
      ]
    in
    if V.all (\r -> r == 0) looks and V.all (\r -> r == 0) keys and added == [0, 0] then 0 else 0 - 1)

-- The game's numbers.
fun ints (sys : M.System) : Ptr ! Process = M.pointer (M.kept sys intsAt)
fun floats (sys : M.System) : Ptr ! Process = M.pointer (M.kept sys floatsAt)
fun geti (sys : M.System) (i : Int) : Int ! Process = M.readInt32At (ints sys) i
fun seti (sys : M.System) (i : Int) (n : Int) : () ! Process = M.writeInt32At (ints sys) i n
fun getf (sys : M.System) (i : Int) : Float ! Process = M.readFloat32 (floats sys) i
fun setf (sys : M.System) (i : Int) (x : Float) : () ! Process = M.writeFloat32 (floats sys) i x

-- A number from 0 to 1, from a generator kept with the game, so that a game can be played
-- again the same way.
fun random (sys : M.System) : Float ! Process =
  let s = (geti sys seedI * 1103515245 + 12345) % 2147483648 in
  let u = seti sys seedI s in
  toFloat s /. 2147483648.0

-- ---------------------------------------------------------------------------------------
-- Pictures, worked out from code

-- A picture's pixels, four numbers each, from what colour each place is.
fun generated (w : Int) (h : Int) (colour : Int -> Int -> (Int, Int, Int, Int)) : [Int] =
  concatMap (\i -> let (r, g, b, a) = colour (i % w) (i / w) in [r, g, b, a]) (range 0 (w * h))

-- A picture drawn as rows of letters, each letter a colour of the palette.
fun drawn (rows : [String]) (palette : String -> (Int, Int, Int, Int)) : [Int] =
  concatMap (\row -> concatMap (\c -> let (r, g, b, a) = palette (C.toString c) in [r, g, b, a]) (S.chars row)) rows


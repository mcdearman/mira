fun dunesVia (h : Int) (at : (Float, Float)) : (Float, Float) =
  let (x, z) = at in
  match h with
  | 3 -> if z >. 1.2 then (1.9, 1.6) else if z >. (-2.2) then (1.9, -2.6) else dunesCup h
  | 4 -> if z >. 1.6 then (0.0, 0.5) else if x <. 4.2 then (5.0, 0.5) else dunesCup h
  | 7 -> if x <. 0.0 and z >. (-3.6) then (-1.5, -4.6) else if x <. 0.0 then (1.5, -4.4) else dunesCup h
  | _ -> dunesCup h


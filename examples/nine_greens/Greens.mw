-- What was built for the last hole goes, and this one is put up.
fun build (sys : M.System) (h : Int) : () ! Process =
  let old = M.foldIn2 sys 1 [] (\acc entity piece tr -> V.pushBack acc entity) in
  let u1 = V.forEach (\entity -> M.despawn sys entity) old in
  let u2 = seti sys builtI h in
  let cube = geti sys cubeI in
  let cylinder = geti sys cylinderI in
  let sphere = geti sys sphereI in
  let plane = geti sys planeI in
  let c = h / holes in
  let green = greenOf c in
  -- The ground round about.
  let (ground, shine) = groundOf c in
  let u0 = piece sys plane (0.0, groundY, 0.0) M.unturned (400.0, 1.0, 400.0) ground shine [0.0, 0.0, 0.0, 0.0] in
  -- The green, a slab a fifth of a metre thick, its top at nought, mown in stripes, on a
  -- bank of earth standing up out of the grass.
  let u3 = V.forEach (\r ->
      let (x0, z0, x1, z1) = r in
      let bank = piece sys cube ((x0 +. x1) /. 2.0, (groundY -. 0.2) /. 2.0, (z0 +. z1) /. 2.0) M.unturned (x1 -. x0 +. wallT, 0.0 -. 0.2 -. groundY, z1 -. z0 +. wallT) (bankOf c) 0.95 [0.0, 0.0, 0.0, 0.0] in
      ()) (floors h) in
  -- The green round the water, which lies lower: mown in stripes half a metre wide, the
  -- same wherever the green is cut.
  let (gr, gg, gb) = green in
  let u3b = V.forEach (\r ->
      let (x0, z0, x1, z1) = r in
      let e = piece sys cube ((x0 +. x1) /. 2.0, -0.1, (z0 +. z1) /. 2.0) M.unturned (x1 -. x0, 0.2, z1 -. z0) (gr *. 0.87, gg *. 0.92, gb *. 0.87) 0.9 [0.0, 0.0, 0.0, 0.0] in
      V.forEach (\band ->
          let (a, b) = band in
          let s = piece sys plane ((a +. b) /. 2.0, 0.0015, (z0 +. z1) /. 2.0) M.unturned (b -. a, 1.0, z1 -. z0) green 0.9 [0.0, 0.0, 0.0, 0.0] in
          ()) (mown x0 x1)) (without (floors h) (water h)) in
  -- The walls, each a little longer than its length so that corners close, down to the
  -- bank, and capped.
  let u4 = V.forEach (\w ->
      let (ax, az, bx, bz) = w in
      let length = apart (ax, az) (bx, bz) in
      let turn = yaw (F.atan2 (bz -. az) (bx -. ax)) in
      let (mx, mz) = ((ax +. bx) /. 2.0, (az +. bz) /. 2.0) in

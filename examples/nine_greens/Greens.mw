  let w6 = seti sys bumpI (M.createSound sys "greens.bump" rate 1 (made 0.3 (\t i -> F.sin (F.tau *. (260.0 *. t +. 1500.0 *. t *. t)) *. F.exp (0.0 -. t *. 11.0) *. 0.5))) in


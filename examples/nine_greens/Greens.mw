  | 1 -> [(-3.0, -7.0, 3.0, 7.0)]
  | 2 -> [(-2.5, -7.0, 2.5, 7.0)]
  | 3 -> [(-1.5, -4.0, 1.5, 7.0), (-6.5, -4.0, -1.5, -1.0)]
  | 4 -> [(-3.0, -7.0, 3.0, 7.0)]
  | 5 -> [(-2.5, -7.0, 2.5, 7.0)]
  | 6 -> [(-3.0, -7.0, 3.0, 7.0)]
  | 7 -> [(-3.0, -7.0, 3.0, 7.0)]
  | _ -> [(-3.0, -8.0, 3.0, 8.0)]

fun lagoonOutline (h : Int) : [(Float, Float)] =
  match h with
  | 0 -> [(-2.5, 7.0), (2.5, 7.0), (2.5, -7.0), (-2.5, -7.0)]
  | 1 -> [(-3.0, 7.0), (3.0, 7.0), (3.0, -7.0), (-3.0, -7.0)]
  | 2 -> [(-2.5, 7.0), (2.5, 7.0), (2.5, -7.0), (-2.5, -7.0)]
  | 3 -> [(-1.5, 7.0), (1.5, 7.0), (1.5, -4.0), (-6.5, -4.0), (-6.5, -1.0), (-1.5, -1.0)]
  | 4 -> [(-3.0, 7.0), (3.0, 7.0), (3.0, -7.0), (-3.0, -7.0)]
  | 5 -> [(-2.5, 7.0), (2.5, 7.0), (2.5, -7.0), (-2.5, -7.0)]
  | 6 -> [(-3.0, 7.0), (3.0, 7.0), (3.0, -7.0), (-3.0, -7.0)]
  | 7 -> [(-3.0, 7.0), (3.0, 7.0), (3.0, -7.0), (-3.0, -7.0)]
  | _ -> [(-3.0, 8.0), (3.0, 8.0), (3.0, -8.0), (-3.0, -8.0)]

fun lagoonInner (h : Int) : [(Float, Float, Float, Float)] =
  match h with
  | _ -> []

fun lagoonPosts (h : Int) : [(Float, Float, Float)] =
  match h with
  | 3 -> [(0.7, -3.3, 0.3)]
  | 4 -> [(0.0, 2.5, 0.3), (-1.0, 0.5, 0.25), (1.0, 0.8, 0.25), (0.0, -1.5, 0.3), (-1.2, -3.0, 0.25), (1.2, -3.2, 0.25)]
  | 7 -> [(-1.8, 3.5, 0.2), (0.6, 3.0, 0.2), (2.0, 1.8, 0.2), (-0.8, 1.2, 0.2), (1.2, -0.4, 0.2), (-2.0, -0.8, 0.2), (0.0, -2.2, 0.2), (-1.2, -3.6, 0.2), (1.9, -3.4, 0.2)]
  | _ -> []

fun lagoonSand (h : Int) : [(Float, Float, Float, Float)] =
  match h with
  | 7 -> [(-3.0, -1.8, -1.0, 0.2), (0.4, 1.0, 3.0, 2.6)]
  | _ -> []

fun lagoonWater (h : Int) : [(Float, Float, Float, Float)] =
  match h with
  | 0 -> [(-2.5, -4.0, -1.0, 4.0), (1.0, -4.0, 2.5, 4.0)]
  | 1 -> [(-3.0, -2.0, -1.8, 0.0), (-1.2, -2.0, 1.2, 0.0), (1.8, -2.0, 3.0, 0.0)]
  | 2 -> [(-2.5, -2.0, -1.7, 2.0), (1.7, -2.0, 2.5, 2.0)]
  | 3 -> [(-6.5, -4.0, -3.5, -3.5)]
  | 4 -> [(-3.0, 1.0, -1.6, 3.0), (1.6, -2.0, 3.0, 0.0)]
  | 5 -> [(1.2, -4.0, 2.5, 3.0)]
  | 6 -> [(-1.5, -3.0, 3.0, 3.0)]
  | 8 -> [(-3.0, -8.0, -1.5, -2.5), (1.5, -8.0, 3.0, -2.5), (-1.5, -4.0, -0.4, -2.5), (0.4, -4.0, 1.5, -2.5), (-1.5, -8.0, 1.5, -7.0)]
  | _ -> []

fun lagoonSlopes (h : Int) : [(Float, Float, Float, Float, Float, Float)] =
  match h with
  | 5 -> [(-2.5, -4.0, 1.2, 3.0, 0.5, 0.0)]
  | _ -> []

fun lagoonSpinners (h : Int) : [(Float, Float, Float, Float)] =
  match h with
  | 2 -> [(0.0, 0.0, 1.3, 1.5)]
  | 8 -> [(-1.0, -1.6, 1.2, 1.4)]
  | _ -> []

fun lagoonVia (h : Int) (at : (Float, Float)) : (Float, Float) =
  let (x, z) = at in
  match h with
  | 1 -> if z >. 0.9 then (1.5, 1.2) else if z >. (-2.4) then (1.5, -2.6) else lagoonCup h
  | 2 -> if z >. 2.3 then (1.45, 2.6) else if z >. (-2.2) then (1.55, -2.4) else lagoonCup h
  | 3 -> if x >. (-1.2) and z >. (-2.0) then (0.0, -2.4) else lagoonCup h
  | 6 -> if x >. (-1.6) and z >. 3.0 then (-2.2, 3.6) else if z >. (-3.2) then (-2.2, -3.6) else lagoonCup h
  | _ -> lagoonCup h

def hubR : Float = 0.16
def barT : Float = 0.14

-- Where the game, playing itself, aims from a place: the cup, or a way round to it.
fun meadowVia (h : Int) (at : (Float, Float)) : (Float, Float) =
  let (x, z) = at in
  match h with
  | 1 -> if z >. (-1.0) then (0.0, -2.6) else cup h
  | 3 -> if z >. 0.6 then (1.45, -0.6) else cup h
  | 7 -> if z >. 3.0 then (2.3, 2.4) else if z >. (-2.5) then (-2.4, -3.1) else cup h
  | 8 -> if z >. (-5.0) then (1.85, -7.4) else if F.abs x >. 1.0 then (0.0, -7.4) else cup h
  | _ -> cup h


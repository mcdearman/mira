  | "S" -> [".ww", "w..", ".w.", "..w", "ww."]
  | "T" -> ["www", ".w.", ".w.", ".w.", ".w."]
  | "U" -> ["w.w", "w.w", "w.w", "w.w", "www"]
  | "V" -> ["w.w", "w.w", "w.w", "w.w", ".w."]
  | "W" -> ["w.w", "w.w", "www", "www", "w.w"]
  | "X" -> ["w.w", "w.w", ".w.", "w.w", "w.w"]
  | "Y" -> ["w.w", "w.w", ".w.", ".w.", ".w."]

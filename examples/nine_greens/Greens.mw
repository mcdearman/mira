-- ---------------------------------------------------------------------------------------
-- Loading

@export
fun mira_plugin_load (api : Int) (app : Int) : Int32 ! Process =
  M.load api app (\p ->
    let transform = M.lookupComponent p "mira.Transform" in
    -- Kept out of the sun's shadows: the words, panels and aiming dots. Not there without
    -- a renderer, and then not needed.
    let unshadowed = M.lookupComponent p "mira.NotShadowCaster" in
    -- A player's ball, by the player's number.
    let ball = M.registerComponent p "greens.Ball" 4 4 in
    -- A piece of the hole being played: what it is (0 still, 1 a turning bar, 2 the flag)
    -- and what it needs to move.
    let course = M.registerComponent p "greens.Course" 16 4 in
    -- An aiming dot by number, the last the ring under the ball to play.
    let dot = M.registerComponent p "greens.Dot" 4 4 in
    let eye = M.registerComponent p "greens.Eye" 4 4 in
    -- A letter or panel on the screen.
    let text = M.registerComponent p "greens.Text" 4 4 in
    let ints = M.state p "greens.ints" 512 4 in
    let floats = M.state p "greens.floats" 256 4 in
    let glyphs = M.state p "greens.glyphs" 256 4 in
    let u = M.keep p [transform, ball, course, dot, eye, text, M.address ints, M.address floats, M.address glyphs, unshadowed] in
    let looks = [M.setting p "taa" 0.0, M.setting p "grain" 0.0, M.setting p "vignette" 0.15, M.setting p "saturation" 1.2] in
    let bound = [
        -- Held and dragged back to putt, with the mouse or a finger.
        M.bindAction p "aim" "MouseLeft",
        M.bindAction p "aim" "Touch",
        -- Or turned with keys, and Space held for how hard.
        M.bindAxis p "turn" "KeyA" "KeyD",
        M.bindAxis p "turn" "ArrowLeft" "ArrowRight",
        M.bindAction p "charge" "Space",
        -- The view: dragged with the right button held, or tilted with W and S.
        M.bindAction p "look" "MouseRight",
        M.bindAxis p "tilt" "KeyS" "KeyW",
        M.bindAction p "on" "Enter",
        M.bindAction p "one" "Digit1",
        M.bindAction p "two" "Digit2",
        M.bindAction p "three" "Digit3",
        M.bindAction p "four" "Digit4"
      ]
    in
    let added = [
        M.addSystem p "setup" M.startup "greens_setup" [],
        M.addSystemWith p "play" M.update "greens_play" [
            [M.reads ball, M.writes transform],
            [M.reads course, M.writes transform, M.lacking ball],
            [M.reads dot, M.writes transform, M.lacking ball, M.lacking course],
            [M.reads eye, M.writes transform, M.lacking ball, M.lacking course, M.lacking dot],
            [M.reads text]
          ]
      ]
    in
    if V.all (\r -> r == 0) looks and V.all (\r -> r == 0) bound and added == [0, 0] then 0 else 0 - 1)

-- The game's numbers.
fun ints (sys : M.System) : Ptr ! Process = M.pointer (M.kept sys intsAt)
fun floats (sys : M.System) : Ptr ! Process = M.pointer (M.kept sys floatsAt)
fun geti (sys : M.System) (i : Int) : Int ! Process = M.readInt32At (ints sys) i
fun seti (sys : M.System) (i : Int) (n : Int) : () ! Process = M.writeInt32At (ints sys) i n
fun getf (sys : M.System) (i : Int) : Float ! Process = M.readFloat32 (floats sys) i
fun setf (sys : M.System) (i : Int) (x : Float) : () ! Process = M.writeFloat32 (floats sys) i x

-- A player's ball: where it is and how fast it goes; and where it was hit from.
fun ballOf (sys : M.System) (p : Int) : (Float, Float, Float, Float) ! Process =
  let b = ballsF + p * 8 in
  (getf sys b, getf sys (b + 1), getf sys (b + 2), getf sys (b + 3))

fun setBall (sys : M.System) (p : Int) (ball : (Float, Float, Float, Float)) : () ! Process =
  let b = ballsF + p * 8 in
  let (x, z, vx, vz) = ball in
  let u1 = setf sys b x in
  let u2 = setf sys (b + 1) z in
  let u3 = setf sys (b + 2) vx in
  setf sys (b + 3) vz

fun spotOf (sys : M.System) (p : Int) : (Float, Float) ! Process =
  let (x, z, vx, vz) = ballOf sys p in
  (x, z)

fun fromOf (sys : M.System) (p : Int) : (Float, Float) ! Process =
  let b = ballsF + p * 8 in
  (getf sys (b + 4), getf sys (b + 5))

fun setFrom (sys : M.System) (p : Int) (at : (Float, Float)) : () ! Process =
  let b = ballsF + p * 8 in
  let (x, z) = at in
  let u = setf sys (b + 4) x in
  setf sys (b + 5) z

-- The hole played, of all the courses' holes.
fun holeAt (sys : M.System) : Int ! Process = geti sys courseI * holes + geti sys holeI

fun scoreOf (sys : M.System) (p : Int) (h : Int) : Int ! Process = geti sys (scoresI + p * holes + h)

fun totalOf (sys : M.System) (p : Int) : Int ! Process = V.foldl (\t h -> t + scoreOf sys p h) 0 (range 0 holes)

-- ---------------------------------------------------------------------------------------
-- Little sums

fun fmin (a : Float) (b : Float) : Float = if a <. b then a else b
fun fmax (a : Float) (b : Float) : Float = if a >. b then a else b
fun fclamp (lo : Float) (hi : Float) (x : Float) : Float = if x <. lo then lo else if x >. hi then hi else x

fun apart (a : (Float, Float)) (b : (Float, Float)) : Float =
  let (ax, az) = a in
  let (bx, bz) = b in
  F.sqrt ((ax -. bx) *. (ax -. bx) +. (az -. bz) *. (az -. bz))

fun inside (rects : [(Float, Float, Float, Float)]) (x : Float) (z : Float) : Bool =
  V.any (\r -> let (x0, z0, x1, z1) = r in x >=. x0 and x <=. x1 and z >=. z0 and z <=. z1) rects

-- Turning about the upright, so that a thing's +x points `angle` round from +x toward +z.
-- A flat picture's top is its +x, so this points that too.
fun yaw (angle : Float) : (Float, Float, Float, Float) = M.around (0.0, 1.0, 0.0) (0.0 -. angle)

-- A flat picture facing the camera, its top up the screen.
def facing : (Float, Float, Float, Float) = (0.5, 0.5, 0.5, 0.5)

-- ---------------------------------------------------------------------------------------
-- The ball rolling: pure sums, a short step at a time

-- One step: slowed by the ground, pulled by any tilt, off walls, posts and bars, and into
-- the cup, the water or off the course. What happened: 0 nothing, 1 in the cup, 2 in the
-- water, 3 off the course; how hard it hit anything; and which bumper it hit, if one.
fun step (h : Int) (now : Float) (dt : Float) (ball : (Float, Float, Float, Float)) : ((Float, Float, Float, Float), Int, Float, Int) =
  let (x, z, vx, vz) = ball in
  let (sx, sz) = slopeAt h x z in
  let ux = vx +. sx *. dt in
  let uz = vz +. sz *. dt in
  let speed = F.sqrt (ux *. ux +. uz *. uz) in
  let drag = if inside (sand h) x z then sandDrag else greenDrag in
  let left = speed -. drag *. dt in
  let k = if left <=. 0.0 then 0.0 else left /. speed in
  let moved = (x +. ux *. k *. dt, z +. uz *. k *. dt, ux *. k, uz *. k) in
  let still = \px pz -> (0.0, 0.0) in
  let walled = offAll (moved, 0.0) (walls h) (\b w -> off b w still (ballR +. wallT /. 2.0) bounce 0.0) in
  let (posted, bumped) = V.foldl (\so i ->
      let (sofar, found) = so in
      let (b, most) = sofar in
      let (px, pz, r) = V.getOr (0.0, 0.0, 0.0) (posts h) i in
      let (nb, hit) = off b (px, pz, px, pz) still (ballR +. r) bumperSpring bumperKick in
      ((nb, fmax hit most), if hit >. 0.0 then i else found)) (walled, 0 - 1) (range 0 (len (posts h))) in
  let (turned, hit) = offAll posted (spinners h) (\b sp -> offSpinner b sp now) in
  let (fx, fz, fvx, fvz) = turned in
  let (cx, cz) = cup h in
  let toCup = apart (fx, fz) (cx, cz) in
  let fast = F.sqrt (fvx *. fvx +. fvz *. fvz) in
  if toCup <. cupR and fast <. dropSpeed then ((cx, cz, 0.0, 0.0), 1, hit, bumped)
  else if inside (water h) fx fz then (turned, 2, hit, bumped)
  else if not (inside (floors h) fx fz) then (turned, 3, hit, bumped)
  -- Too fast to drop: over the lip, slowed and drawn a little toward the middle.
  else if toCup <. cupR then ((fx, fz, fvx *. 0.97 +. (cx -. fx) *. 0.5, fvz *. 0.97 +. (cz -. fz) *. 0.5), 0, hit, bumped)
  else (turned, 0, hit, bumped)

fun slopeAt (h : Int) (x : Float) (z : Float) : (Float, Float) =
  match V.find (\s -> let (x0, z0, x1, z1, ax, az) = s in inside [(x0, z0, x1, z1)] x z) (slopes h) with
  | Just s -> (let (x0, z0, x1, z1, ax, az) = s in (ax, az))
  | None -> (0.0, 0.0)

-- The ball off a segment (a post is one of no length) that may be moving: pushed back out
-- to `reach` of it, and bounced if it was going into it, keeping `spring` of its speed into
-- it and kicked `kick` faster away. And how hard it went in.
fun off (ball : (Float, Float, Float, Float)) (seg : (Float, Float, Float, Float)) (moving : Float -> Float -> (Float, Float)) (reach : Float) (spring : Float) (kick : Float) : ((Float, Float, Float, Float), Float) =
  let (x, z, vx, vz) = ball in
  let (ax, az, bx, bz) = seg in
  let dx = bx -. ax in
  let dz = bz -. az in
  let ll = dx *. dx +. dz *. dz in
  let t = if ll == 0.0 then 0.0 else fclamp 0.0 1.0 (((x -. ax) *. dx +. (z -. az) *. dz) /. ll) in
  let px = ax +. dx *. t in
  let pz = az +. dz *. t in
  let ox = x -. px in
  let oz = z -. pz in
  let d = F.sqrt (ox *. ox +. oz *. oz) in
  if d >=. reach or d == 0.0 then (ball, 0.0)
  else
    let nx = ox /. d in
    let nz = oz /. d in
    let (wx, wz) = moving px pz in
    let into = (vx -. wx) *. nx +. (vz -. wz) *. nz in
    let x2 = px +. nx *. reach in
    let z2 = pz +. nz *. reach in
    if into >=. 0.0 then ((x2, z2, vx, vz), 0.0)
    else
      let push = kick -. (1.0 +. spring) *. into in
      ((x2, z2, vx +. push *. nx, vz +. push *. nz), 0.0 -. into)

-- The ball off each of some pieces in turn, and the hardest it hit one.
fun offAll (start : ((Float, Float, Float, Float), Float)) (pieces : [a]) (hitOf : (Float, Float, Float, Float) -> a -> ((Float, Float, Float, Float), Float)) : ((Float, Float, Float, Float), Float) =
  V.foldl (\so piece -> let (b, most) = so in let (nb, hit) = hitOf b piece in (nb, fmax hit most)) start pieces

-- A turning bar, `half` long each way from its hub, at `now`; and the hub.
fun offSpinner (ball : (Float, Float, Float, Float)) (sp : (Float, Float, Float, Float)) (now : Float) : ((Float, Float, Float, Float), Float) =
  let (sx, sz, half, speed) = sp in
  let a = speed *. now in
  let (ex, ez) = (F.cos a *. half, F.sin a *. half) in
  let sweep = \px pz -> (0.0 -. speed *. (pz -. sz), speed *. (px -. sx)) in
  let (b1, hit1) = off ball (sx -. ex, sz -. ez, sx +. ex, sz +. ez) sweep (ballR +. barT /. 2.0) bounce 0.0 in
  let (b2, hit2) = off b1 (sx, sz, sx, sz) (\px pz -> (0.0, 0.0)) (ballR +. hubR) bounce 0.0 in
  (b2, fmax hit1 hit2)

-- So many steps.
fun steps (h : Int) (now : Float) (dt : Float) (n : Int) (ball : (Float, Float, Float, Float)) (most : Float) (bumpedSoFar : Int) : ((Float, Float, Float, Float), Int, Float, Int) =
  if n <= 0 then (ball, 0, most, bumpedSoFar)
  else
    let (next, event, hit, bumped) = step h now dt ball in
    let harder = fmax hit most in
    let anyBumped = if bumped >= 0 then bumped else bumpedSoFar in
    if event != 0 then (next, event, harder, anyBumped) else steps h (now +. dt) dt (n - 1) next harder anyBumped

-- ---------------------------------------------------------------------------------------
-- Pictures, worked out from code

fun generated (w : Int) (h : Int) (colour : Int -> Int -> (Int, Int, Int, Int)) : [Int] =
  concatMap (\i -> let (r, g, b, a) = colour (i % w) (i / w) in [r, g, b, a]) (range 0 (w * h))

fun drawn (rows : [String]) (palette : String -> (Int, Int, Int, Int)) : [Int] =
  concatMap (\row -> concatMap (\c -> let (r, g, b, a) = palette (C.toString c) in [r, g, b, a]) (S.chars row)) rows

def clear : (Int, Int, Int, Int) = (0, 0, 0, 0)
def white : (Int, Int, Int, Int) = (255, 255, 255, 255)

-- How far a pixel's middle is from the middle of a picture `size` across.
fun fromMiddle (size : Int) (x : Int) (y : Int) : Float =
  let c = toFloat size /. 2.0 in
  let dx = toFloat x +. 0.5 -. c in
  let dy = toFloat y +. 0.5 -. c in
  F.sqrt (dx *. dx +. dy *. dy)

-- The cup seen from above, and the ring under the ball to play.
fun discColour (x : Int) (y : Int) : (Int, Int, Int, Int) = if fromMiddle 32 x y <. 15.5 then white else clear
fun ringColour (x : Int) (y : Int) : (Int, Int, Int, Int) = let d = fromMiddle 32 x y in if d <. 15.5 and d >. 11.5 then white else clear

-- The cup as the camera sees into it, the camera toward the bottom of the picture: the
-- white lining of its far side, its dark bottom, and a bright lip round its rim.
fun cupColour (x : Int) (y : Int) : (Int, Int, Int, Int) =
  let rim = fromMiddle 64 x y in
  let dx = toFloat x +. 0.5 -. 32.0 in
  let dy = toFloat y +. 0.5 -. 50.0 in
  let toBottom = F.sqrt (dx *. dx +. dy *. dy) in
  if rim >=. 31.0 then clear
  else if rim >=. 29.0 then (250, 250, 244, 255)
  else if toBottom <. 31.0 then (8, 10, 9, 255)
  else
    -- Down the lining: lit at the lip, darker deeper.
    let deep = fclamp 0.0 1.0 ((31.0 -. (toBottom -. 31.0)) /. 31.0) in
    let v = floor (235.0 -. 150.0 *. deep *. deep) in
    (v, v, v - 8, 255)

-- The head of the arrow aimed: a wedge, its point at the top.
fun arrowColour (x : Int) (y : Int) : (Int, Int, Int, Int) =
  let half = (toFloat y +. 0.5) *. 0.5 in
  if y >= 2 and y < 30 and F.abs (toFloat x +. 0.5 -. 16.0) <. half then white else clear

-- An arrow head, its point at the top, to show which way the ground falls.
fun chevronColour (x : Int) (y : Int) : (Int, Int, Int, Int) =
  let d = F.abs (toFloat x +. 0.5 -. 8.0) in
  let rise = toFloat y -. 2.0 -. d in
  if d <. 7.0 and rise >=. 0.0 and rise <. 3.5 then white else clear

-- The letters, five pixels by seven.
fun letterRows (c : String) : [String] =
  match c with
  | "A" -> [".www.", "w...w", "w...w", "wwwww", "w...w", "w...w", "w...w"]
  | "B" -> ["wwww.", "w...w", "w...w", "wwww.", "w...w", "w...w", "wwww."]
  | "C" -> [".www.", "w...w", "w....", "w....", "w....", "w...w", ".www."]
  | "D" -> ["wwww.", "w...w", "w...w", "w...w", "w...w", "w...w", "wwww."]
  | "E" -> ["wwwww", "w....", "w....", "wwww.", "w....", "w....", "wwwww"]
  | "F" -> ["wwwww", "w....", "w....", "wwww.", "w....", "w....", "w...."]
  | "G" -> [".www.", "w...w", "w....", "w.www", "w...w", "w...w", ".wwww"]
  | "H" -> ["w...w", "w...w", "w...w", "wwwww", "w...w", "w...w", "w...w"]
  | "I" -> [".www.", "..w..", "..w..", "..w..", "..w..", "..w..", ".www."]
  | "J" -> ["..www", "...w.", "...w.", "...w.", "...w.", "w..w.", ".ww.."]
  | "K" -> ["w...w", "w..w.", "w.w..", "ww...", "w.w..", "w..w.", "w...w"]
  | "L" -> ["w....", "w....", "w....", "w....", "w....", "w....", "wwwww"]
  | "M" -> ["w...w", "ww.ww", "w.w.w", "w.w.w", "w...w", "w...w", "w...w"]
